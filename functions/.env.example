# Non-secret Functions params (firebase-functions/params defineString).
# Secrets are NOT here — set those with:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Where Stripe Checkout returns the user. Must be an origin you control.
APP_URL=https://inv-tracker-e2e40.web.app

# Stripe recurring price IDs (Dashboard > Product catalogue > pricing).
# These stay server-side so a tampered request can't name a cheaper price than
# the plan it claims.
STRIPE_PRICE_WEEKLY=price_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx
