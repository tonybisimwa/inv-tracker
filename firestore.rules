rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().isAdmin == true;
    }

    // These fields decide what a user can see and do. If a user can write them
    // on their own profile they can simply grant themselves admin, so they are
    // admin-only — everything else on the profile is the owner's to edit.
    function privilegedFields() {
      return ['isAdmin', 'isVIP', 'vipPlan', 'vipUntil', 'vipUntilMs'];
    }

    // VIP that hasn't lapsed. vipUntilMs is an epoch-millis mirror of the
    // vipUntil ISO string, because rules can't parse date strings. Profiles
    // written before it existed have no expiry recorded, so they stay active.
    function activeVIP() {
      let u = userDoc();
      return signedIn()
        && u.isVIP == true
        && (!('vipUntilMs' in u) || u.vipUntilMs == null || request.time.toMillis() < u.vipUntilMs);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // A profile must be created unprivileged. Written as an absent-or-false
      // check rather than Map.get(k, default) to stay on syntax that's stable
      // across rules versions.
      allow create: if isOwner(uid)
                    && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
                    && (!('isVIP' in request.resource.data) || request.resource.data.isVIP == false);

      // Owners may edit their own profile (bankroll, units, lesson progress…)
      // but never the fields that grant access
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedFields());

      // Admins manage profiles, including granting and revoking VIP
      allow create, update, delete: if isAdmin();

      // A user's bet journal is private to them — admins included
      match /bets/{betId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Plays — the paywall has to live here, not in the client. Previously any
    // signed-in user could read every VIP play straight out of Firestore.
    // Non-VIP clients must query with where('tier', '==', 'free'); rules are
    // filters on the result set, not on the documents themselves.
    match /plays/{playId} {
      allow read: if signedIn() && (resource.data.tier == 'free' || activeVIP() || isAdmin());
      allow write: if isAdmin();
    }

    // VIP requests — a user opens their own request and cannot pre-approve it
    match /vipRequests/{reqId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Tipster settings, including the public win/loss record. Readable by all
    // signed-in users so non-VIPs still see an honest track record without
    // being able to read the VIP picks behind it.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
