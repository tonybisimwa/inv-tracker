VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OpenAI API key for slip scanning (platform.openai.com)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Stripe Payment Links (create at dashboard.stripe.com > Payment Links)
VITE_STRIPE_LINK_WEEKLY=https://buy.stripe.com/your_weekly_link
VITE_STRIPE_LINK_MONTHLY=https://buy.stripe.com/your_monthly_link
VITE_STRIPE_LINK_YEARLY=https://buy.stripe.com/your_yearly_link

# Manual payment handles (shown to users on the checkout page)
VITE_CASHAPP_TAG=$YourCashTag
VITE_VENMO_HANDLE=@YourVenmo
VITE_PAYPAL_ME=paypal.me/YourHandle
